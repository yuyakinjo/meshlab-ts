{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!.reference", "!test/fixtures/golden"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useNamingConvention": "off"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"performance": {
				"noDelete": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/vcg/**", "src/common/**", "src/meshlabplugins/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"../complex/cursor.ts": "cursor.ts allocates per element and is for tests/CLI only; use index-based accessors in kernel code.",
									"../../vcg/complex/cursor.ts": "cursor.ts allocates per element and is for tests/CLI only; use index-based accessors in kernel code."
								}
							}
						}
					}
				}
			}
		}
	]
}
