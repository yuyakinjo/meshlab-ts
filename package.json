{
	"name": "meshlab-ts",
	"version": "0.0.0",
	"description": "A TypeScript/Bun port of MeshLab, mirroring the MeshLab C++ plugin architecture",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"private": true,
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"meshlab-ts": "./bin/meshlab-ts"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test",
		"test:prop:deep": "FAST_CHECK_NUM_RUNS=5000 bun test test/property",
		"reference:clone": "bun run scripts/clone-reference.ts",
		"stub:gen": "bun run scripts/gen-stub-table.ts",
		"registry:check": "bun run scripts/check-registry.ts",
		"golden:regen": "bun run scripts/regen-golden.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/bun": "^1.3.14",
		"fast-check": "^4.9.0",
		"typescript": "^7.0.2"
	}
}
